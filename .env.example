# ==== BestConsulting AI Core v2.2 — Environment Variables ====

# === Основные ===
APP_ENV=production
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-here
WEBHOOK_SECRET=your-webhook-secret-here
AGENT_NAME=Высокотехнологичный сотрудник Bestconsulting

# === LLM Провайдеры ===
# OpenAI — основной оркестратор
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# DeepSeek — аналитика, резерв
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Anthropic Claude — длинные документы, резерв
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Qwen — программирование, резерв
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-coder-plus-latest

# === Каналы ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

MAX_API_TOKEN=
MAX_API_URL=https://api.max.ru/v1

EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_SMTP_SERVER=smtp.mail.ru
EMAIL_SMTP_PORT=465
EMAIL_IMAP_SERVER=imap.mail.ru
EMAIL_IMAP_PORT=993

# === Google / YouTube ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=

# === База данных ===
# SQLite (для локального теста):
# DATABASE_URL=sqlite+aiosqlite:///./bestconsulting.db
# PostgreSQL (Railway):
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# === Кэш / Очереди ===
REDIS_URL=

# === Мониторинг ===
SENTRY_DSN=
